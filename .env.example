# ═══════════════════════════════════════════════════════
# StockRadar V2 配置文件
# 复制为 .env 后修改对应值
# ═══════════════════════════════════════════════════════

# ── 数据源选择 ──
# 支持: baostock（默认/免费）| tushare | akshare | wind
DATA_SOURCE=baostock

# ── Tushare 配置（仅 DATA_SOURCE=tushare 时需要）──
# 在 https://tushare.pro 注册获取 token
TUSHARE_TOKEN=your-tushare-token

# ── 数据库路径 ──
DB_PATH=data/stockradar.db

# ── 数据起始日期 ──
START_DATE=2024-01-01

# ── 默认飞书 Webhook URL（可选，不填则跳过推送）──
FEISHU_WEBHOOK_URL=

# ── 策略专属 Webhook（可选，格式：STRATEGY_WEBHOOK_<策略标识>=<URL>）──
# 未配置的策略将自动使用默认 FEISHU_WEBHOOK_URL
# STRATEGY_WEBHOOK_MA_VOLUME=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# STRATEGY_WEBHOOK_TURTLE=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# STRATEGY_WEBHOOK_FLAG=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# STRATEGY_WEBHOOK_SHAKEOUT=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# STRATEGY_WEBHOOK_LIMIT_DOWN=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# STRATEGY_WEBHOOK_RPS=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# STRATEGY_WEBHOOK_PRIVATE_PLACEMENT=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
